# SERVER
PORT=3520
PORT_SOCKET=4520

# DATABASE
DATABASE_URL="postgresql://<user>:<password>@127.0.0.1:5432/miyabi_restaurant?schema=restaurant"
# Docker: same database as seen from the container (host.docker.internal instead of 127.0.0.1)
DOCKER_DATABASE_URL="postgresql://<user>:<password>@host.docker.internal:5432/miyabi_restaurant?schema=restaurant"

# CACHE
REDIS_URL=redis://127.0.0.1:6379

# CLOUD (miyabi-api)
CLOUD_GRPC_URL=127.0.0.1:5510

# JWT (local employees; managers use the cloud's)
JWT_SECRET_TOKEN=
JWT_SECRET_REFRESH_TOKEN=
JWT_SECRET_PASSWORD_TOKEN=

# EXPIRATIONS (seconds)
JWT_EXPIRES_TOKEN=900
JWT_EXPIRES_REFRESH_TOKEN=604800
JWT_EXPIRES_PASSWORD_TOKEN=900

# ENCRYPTION: 32 bytes in base64, encrypts the server token in the database
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
