                <mxCell id="48" value="¿La sesión es válida para la nube?" style="rhombus;whiteSpace=wrap;html=1;rounded=1;arcSize=0;" parent="1" vertex="1"><mxGeometry x="390" y="1585" width="220" height="130" as="geometry"/></mxCell>
