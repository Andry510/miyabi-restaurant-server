<mxfile host="app.diagrams.net">
    <diagram id="d" name="Page-1">
        <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1845" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="2" value="HttpManagerAccessGuard&lt;br&gt;&lt;span style=&quot;font-size: 11px; font-weight: normal;&quot;&gt;Global. Resuelve la sesión del gerente en cualquier ruta con Bearer mss_... y valida su access_token de la nube en las rutas con @HttpManagerAccess()&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=14;" parent="1" vertex="1"><mxGeometry x="40" y="30" width="680" height="48" as="geometry"/></mxCell>
                <mxCell id="3" value="Inicio" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;" parent="1" vertex="1"><mxGeometry x="460" y="95" width="80" height="40" as="geometry"/></mxCell>
                <mxCell id="4" value="¿Trae Authorization: Bearer con un session_token (mss_...)?" style="rhombus;whiteSpace=wrap;html=1;rounded=1;arcSize=0;" parent="1" vertex="1"><mxGeometry x="390" y="165" width="220" height="130" as="geometry"/></mxCell>
                <mxCell id="5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontStyle=1;" parent="1" source="3" target="4" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="6" value="¿Existe la sesión? (se busca por la huella SHA-256 del token)" style="rhombus;whiteSpace=wrap;html=1;rounded=1;arcSize=0;" parent="1" vertex="1"><mxGeometry x="390" y="325" width="220" height="130" as="geometry"/></mxCell>
                <mxCell id="7" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontStyle=1;" parent="1" source="4" target="6" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="8" value="Sesión inválida (401)&lt;br&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;ERROR_MANAGER_SESSION_INVALID&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;" parent="1" vertex="1"><mxGeometry x="130" y="350" width="200" height="80" as="geometry"/></mxCell>
                <mxCell id="9" value="Fin" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;" parent="1" vertex="1"><mxGeometry x="0" y="370" width="80" height="40" as="geometry"/></mxCell>
                <mxCell id="10" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontStyle=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" parent="1" source="6" target="8" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" parent="1" source="8" target="9" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="12" value="¿Tiene 30 minutos o menos sin uso?" style="rhombus;whiteSpace=wrap;html=1;rounded=1;arcSize=0;" parent="1" vertex="1"><mxGeometry x="390" y="485" width="220" height="130" as="geometry"/></mxCell>
                <mxCell id="13" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontStyle=1;" parent="1" source="6" target="12" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="14" value="La cierra como un logout (nube, fila, caché y sockets) y responde 401&lt;br&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;ERROR_MANAGER_SESSION_EXPIRED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;" parent="1" vertex="1"><mxGeometry x="130" y="510" width="200" height="80" as="geometry"/></mxCell>
                <mxCell id="15" value="Fin" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;" parent="1" vertex="1"><mxGeometry x="0" y="530" width="80" height="40" as="geometry"/></mxCell>
                <mxCell id="16" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontStyle=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" parent="1" source="12" target="14" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" parent="1" source="14" target="15" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="18" value="Si al access_token de la nube le falta menos de 1 minuto, lo renueva con session.refresh_token (una sola renovación a la vez por sesión) y guarda los tokens nuevos cifrados" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1"><mxGeometry x="390" y="645" width="220" height="70" as="geometry"/></mxCell>
                <mxCell id="19" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontStyle=1;" parent="1" source="12" target="18" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="20" value="¿Hay un access_token vigente?" style="rhombus;whiteSpace=wrap;html=1;rounded=1;arcSize=0;" parent="1" vertex="1"><mxGeometry x="390" y="745" width="220" height="130" as="geometry"/></mxCell>
                <mxCell id="21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontStyle=1;" parent="1" source="18" target="20" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="22" value="Renovación rechazada: borra la sesión (401) · la nube no responde: la sesión sigue (503)&lt;br&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;ERROR_MANAGER_SESSION_EXPIRED · ERROR_CLOUD_UNAVAILABLE · ERROR_SERVER_UNLINKED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;" parent="1" vertex="1"><mxGeometry x="130" y="770" width="200" height="80" as="geometry"/></mxCell>
                <mxCell id="23" value="Fin" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;" parent="1" vertex="1"><mxGeometry x="0" y="790" width="80" height="40" as="geometry"/></mxCell>
                <mxCell id="24" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontStyle=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" parent="1" source="20" target="22" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" parent="1" source="22" target="23" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="26" value="Deja el access_token en request.cloud_access_token (lo devuelve @HttpAuthorization) y marca el uso, como mucho una vez por minuto" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1"><mxGeometry x="390" y="905" width="220" height="70" as="geometry"/></mxCell>
                <mxCell id="27" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontStyle=1;" parent="1" source="20" target="26" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="28" value="¿La ruta tiene @HttpManagerAccess()?" style="rhombus;whiteSpace=wrap;html=1;rounded=1;arcSize=0;" parent="1" vertex="1"><mxGeometry x="390" y="1005" width="220" height="130" as="geometry"/></mxCell>
                <mxCell id="29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontStyle=1;" parent="1" source="26" target="28" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="30" value="Pasa al controller sin validar con la nube" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;" parent="1" vertex="1"><mxGeometry x="130" y="1030" width="200" height="80" as="geometry"/></mxCell>
                <mxCell id="31" value="Fin" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;" parent="1" vertex="1"><mxGeometry x="0" y="1050" width="80" height="40" as="geometry"/></mxCell>
                <mxCell id="32" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontStyle=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" parent="1" source="28" target="30" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" parent="1" source="30" target="31" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="34" value="¿Hay access_token de la nube?" style="rhombus;whiteSpace=wrap;html=1;rounded=1;arcSize=0;" parent="1" vertex="1"><mxGeometry x="390" y="1165" width="220" height="130" as="geometry"/></mxCell>
                <mxCell id="35" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontStyle=1;" parent="1" source="28" target="34" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="36" value="Sin Bearer: falta el token (401)&lt;br&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;ERROR_MISSING_TOKEN&lt;/font&gt;&lt;br&gt;JWT de empleado inválido: su error (401)&lt;br&gt;Empleado válido: sin permiso (403)&lt;br&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;ERROR_FORBIDDEN&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;" parent="1" vertex="1"><mxGeometry x="110" y="1170" width="220" height="120" as="geometry"/></mxCell>
                <mxCell id="37" value="Fin" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;" parent="1" vertex="1"><mxGeometry x="0" y="1210" width="80" height="40" as="geometry"/></mxCell>
                <mxCell id="38" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontStyle=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" parent="1" source="34" target="36" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" parent="1" source="36" target="37" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="40" value="Busca la huella del access_token en Redis; si no está, llama a session.validate en la nube (server_token + access_token, 10 s) y guarda el resultado hasta que vence el token" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1"><mxGeometry x="390" y="1325" width="220" height="70" as="geometry"/></mxCell>
                <mxCell id="41" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontStyle=1;" parent="1" source="34" target="40" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="42" value="¿Estaba en Redis o la nube respondió?" style="rhombus;whiteSpace=wrap;html=1;rounded=1;arcSize=0;" parent="1" vertex="1"><mxGeometry x="390" y="1425" width="220" height="130" as="geometry"/></mxCell>
                <mxCell id="43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontStyle=1;" parent="1" source="40" target="42" edge="1"><mxGeometry relative="1" as="geometry"/></mxCell>
                <mxCell id="44" value="La nube no responde (503)&lt;br&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;ERROR_CLOUD_UNAVAILABLE · ERROR_SERVER_UNLINKED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;" parent="1" vertex="1"><mxGeometry x="130" y="1450" width="200" height="80" as="geometry"/></mxCell>
